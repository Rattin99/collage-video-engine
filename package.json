{
  "name": "collage-video-engine",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.527",
    "mediabunny": "1.61.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.527",
    "sketches": "file:../Sketches"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.527",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:preview": "remotion render --scale=0.5 --concurrency=2 --codec=h264 --hardware-acceleration=if-possible --crf=28",
    "render:final": "remotion render --codec=prores --prores-profile=422hq --concurrency=3",
    "render:final-h264": "remotion render --codec=h264 --hardware-acceleration=if-possible --crf=18 --concurrency=3",
    "render:alpha": "remotion render --codec=prores --prores-profile=4444 --pixel-format=yuva444p10le --image-format=png --concurrency=2",
    "render:alpha-webm": "remotion render --codec=vp9 --pixel-format=yuva420p --image-format=png --concurrency=2"
  },
  "sideEffects": [
    "*.css"
  ]
}
